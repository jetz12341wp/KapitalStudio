# Puerto donde corre el backend (y sirve también el front-end de /public)
PORT=3000

# Zona horaria del negocio (Perú no tiene horario de verano, offset fijo)
BUSINESS_TIMEZONE=America/Lima
BUSINESS_TIMEZONE_OFFSET=-05:00

# Token secreto para consultar GET /api/appointments (panel de solo lectura).
# Genera uno propio, ej: openssl rand -hex 24
ADMIN_TOKEN=

# ID del calendario de Google donde se crean las citas.
# El calendario principal de una cuenta se ve como "primary" o como su email;
# si usas un calendario secundario, cópialo desde
# Ajustes del calendario > Integrar calendario > ID de calendario.
GOOGLE_CALENDAR_ID=

# Credenciales del Service Account (elige UNA de las dos opciones):

# Opción A: pega aquí el contenido completo del JSON del service account (una sola línea).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Opción B: ruta al archivo JSON del service account en el servidor.
GOOGLE_APPLICATION_CREDENTIALS=
