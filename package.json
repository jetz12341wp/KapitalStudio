{
  "name": "kapital-studio",
  "private": true,
  "description": "Sitio de Kápital Studio (Cloudflare Worker con D1 para la agenda de días no disponibles)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kapital-studio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kapital-studio-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
